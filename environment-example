# Example environment for the API server. Copy it to .env and edit it.
#
# Generated from config/env.schema.json by `yarn env:generate`. Edit the
# schema, not this file. docs/self-hosting/configuration.md describes every
# variable, including the ones not listed here.
#
# A value written as <...> is treated as unset, with a warning at start.
# Settings for user sign-up and email are in environment-example.polite-ai.

# ── Core service ──────────────────────────────────────────────────────────────
# Listen port, logging and how the services find each other.

# HTTP and WebSocket listen port. Wins over PORT when both are set.
# WS_PORT=4000

# Log level: fatal, error, warn, info, debug or trace.
LOGLEVEL=info

# Base URL of the API server, without /api (for example
# http://localhost:4000), that the voice workers call back to.
# SERVICE_BASE_URI=http://localhost:4000

# Token the voice workers send to the API as x-shared-token. It gives full
# access to every route, so use a long random value (openssl rand -hex 32).
# Needed when you run a worker.
# SHARED_API_TOKEN=

# ── Access and secrets ────────────────────────────────────────────────────────
# The first API key and encryption of stored secrets.

# First API key for a new instance. On a database with no users the server
# creates one organisation, one superAdmin user and this key at start. Ignored
# once any user exists. 32 characters or more. Or leave it unset and run yarn
# bootstrap.
# BOOTSTRAP_API_KEY=

# Key that encrypts stored SIP passwords and agent key material. Unset means
# they are stored in plain text, with a warning. Set it in every real
# deployment (openssl rand -base64 32) and never change it once data exists.
# CREDENTIALS_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection. The API server and the Jambonz worker connect
# directly.

# Database host.
POSTGRES_HOST=localhost

# Database port.
POSTGRES_PORT=5432

# Database name.
POSTGRES_DB=llmvoice

# Database user.
POSTGRES_USER=llm

# Database password. Use letters and digits only: it is also placed in a
# connection URL without escaping.
POSTGRES_PASSWORD=

# ── Model providers ───────────────────────────────────────────────────────────
# Set at least one. A provider whose key is unset is not listed in GET
# /models.

# OpenAI key: text models, and OpenAI Realtime and GPT-Live on the voice
# workers.
# OPENAI_API_KEY=

# Anthropic key: Claude text models.
# ANTHROPIC_API_KEY=

# Google AI Studio key: Gemini text models, and Gemini Live on the LiveKit
# worker.
# GOOGLE_API_KEY=

# Ultravox key: the Ultravox runtime (no worker needed) and Ultravox rows on
# the voice workers.
# ULTRAVOX_API_KEY=

# xAI key: Grok text models and the Grok voice rows.
# XAI_API_KEY=

# DeepSeek key: DeepSeek text models.
# DEEPSEEK_KEY=

# Moonshot key: Kimi text models.
# KIMI_KEY=

# OpenRouter key: OpenRouter text models.
# OPENROUTER_KEY=

# ElevenLabs key: TTS on pipeline rows, ElevenLabs Agents rows, and the voice
# list.
# ELEVENLABS_API_KEY=

# ── Speech providers ──────────────────────────────────────────────────────────
# Speech-to-text and text-to-speech for pipeline (STT, LLM, TTS) rows.
# Speech-to-speech rows do not need them.

# Deepgram key: speech-to-text on pipeline rows.
# DEEPGRAM_API_KEY=

# Cartesia key: text-to-speech, and the voice list.
# CARTESIA_API_KEY=

# Neuphonic key: text-to-speech, and the voice list.
# NEUPHONIC_API_KEY=

# ── LiveKit runtime ───────────────────────────────────────────────────────────
# LiveKit Cloud or a self-hosted LiveKit server. Unset means the livekit
# models are not listed.

# LiveKit server URL (wss://...). Browsers connect to it too, so it must be
# reachable from them.
# LIVEKIT_URL=

# LiveKit API key.
# LIVEKIT_API_KEY=

# LiveKit API secret.
# LIVEKIT_API_SECRET=

# ── Pipecat runtime ───────────────────────────────────────────────────────────
# The Pipecat worker. Unset means the pipecat models are not listed.

# URL the API dispatches Pipecat sessions to.
# PIPECAT_WORKER_URL=

# Bearer token on dispatch calls. Same value on the API and the worker.
# PIPECAT_DISPATCH_TOKEN=

# Secret that signs browser join requests. Same value on the API and the
# worker.
# PIPECAT_JOIN_SECRET=

# Public URL of the Pipecat worker that browsers connect to.
# PIPECAT_PUBLIC_URL=

# ── Jambonz runtime ───────────────────────────────────────────────────────────
# An external Jambonz cluster for SIP calls. Unset means the jambonz models
# are not listed.

# Jambonz API host name.
# JAMBONZ_SERVER=

# Jambonz API key.
# JAMBONZ_API_KEY=

# Public DNS name of the Jambonz worker that Jambonz calls back to.
# JAMBONZ_AGENT_NAME=

# ── Recording and stored audio ────────────────────────────────────────────────
# Where call recordings and cached fallback messages are kept.

# Where call recordings go: gs://bucket/prefix (Google Cloud Storage),
# s3://bucket/prefix (S3 or an S3-compatible store) or file:///directory (a
# directory the workers and the API share). Unset means recording is off,
# except that a process with Google credentials keeps the old default bucket
# gs://llm-voice/<NODE_ENV>-recordings.
# RECORDING_STORAGE_PATH=

# Endpoint of an S3-compatible store, for example http://minio:9000. Unset
# means AWS S3 in S3_REGION.
# S3_ENDPOINT=

# S3 access key id.
# S3_ACCESS_KEY_ID=

# S3 secret access key.
# S3_SECRET_ACCESS_KEY=
