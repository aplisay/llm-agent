<?xml version="1.0"?>
<!--
  Dialplan for the Pipecat agent FreeSWITCH.

  Inbound only. A SIP INVITE arrives on the `external` profile; we capture the
  section-6 wire headers (X-Aplisay-Trunk, X-Aplisay-PhoneRegistration,
  X-Lk-RealIp, X-Lk-Transport, X-Aplisay-Call-Id) into channel variables, answer,
  and start mod_audio_stream to the Pipecat worker. The worker reads those
  variables out of the audio_stream "start" event metadata and uses them in its
  inbound dispatch path.

  Outbound calls do NOT use the dialplan: the worker originates the carrier leg
  directly via esl-poller (`sofia/gateway/sbc/<dest>` or, for a registration
  target, `sofia/external/sip:<dest>@<b2bua>:5070`), pinning
  origination_uuid=channelUuid and starting uuid_audio_stream via api_on_answer
  so the streamed leg correlates to the worker's pending originate. See
  esl-poller/src/call-api.ts.

  Transfers (REFER and blind-bridge) are driven from the worker via ESL —
  `uuid_deflect` for REFER, `uuid_bridge` for blind-bridge.

  Note: mod_audio_stream exposes only the `uuid_audio_stream` API (there is no
  `audio_stream` dialplan application), so media is started with api_on_answer,
  not execute_on_answer.
-->
<include>
  <context name="default">

    <!-- Inbound: SIP INVITE → stream to Pipecat -->
    <extension name="inbound_to_pipecat">
      <condition field="${sip_refer_to}" expression="^$"/>
      <condition field="destination_number" expression=".+">
        <action application="log" data="INFO inbound call from=${caller_id_number} to=${destination_number}"/>

        <!-- Preserve trunk / registration identity for the worker. The header
             names mirror the contract in docs/livekit-agent-architecture.md
             section 6 verbatim. -->
        <action application="set" data="aplisay_trunk=${sip_h_X-Aplisay-Trunk}"/>
        <action application="set" data="aplisay_phone_registration=${sip_h_X-Aplisay-PhoneRegistration}"/>
        <action application="set" data="aplisay_called=${sip_h_X-Aplisay-Called}"/>
        <action application="set" data="aplisay_call_id=${sip_h_X-Aplisay-Call-Id}"/>
        <action application="set" data="aplisay_b2bua_ip=${sip_h_X-Lk-RealIp}"/>
        <action application="set" data="aplisay_b2bua_transport=${sip_h_X-Lk-Transport}"/>

        <!-- Answer and stream audio to the worker over WebSocket.
             mod_audio_stream sends/receives L16 PCM 16kHz mono; the channel
             variables above ride the "start" event payload. -->
        <action application="answer"/>
        <action application="set" data="api_on_answer=uuid_audio_stream ${uuid} start $${pipecat_ws_url} mono 16k"/>
        <action application="park"/>
      </condition>
    </extension>

  </context>
</include>
