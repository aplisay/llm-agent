<?xml version="1.0"?>
<include>
  <gateways>
    <!-- Outbound gateways are added dynamically by the Pipecat worker via ESL
         when an outbound originate needs one. -->
  </gateways>
  <profile name="external">
    <settings>
      <param name="domain" value="$${domain}" parse="true"/>
      <param name="ext-sip-ip" value="$${ext_ipv4_address}"/>
      <param name="ext-rtp-ip" value="$${ext_ipv4_address}"/>
      <param name="sip-ip" value="$${local_ip_v4}"/>
      <param name="sip-port" value="$${sip_port}"/>
      <param name="dialplan" value="XML"/>
      <param name="context" value="default"/>
      <param name="rtp-ip" value="$${local_ip_v4}"/>
      <param name="rtp-timeout-sec" value="300"/>
      <param name="rtp-hold-timeout-sec" value="1800"/>

      <param name="auth-calls" value="false"/>
      <param name="disable-register" value="true"/>

      <param name="aggressive-nat-detection" value="true"/>
      <param name="rtp-secure-media" value="optional"/>

      <param name="user-agent-string" value="Aplisay Pipecat Agent FS"/>
    </settings>
  </profile>
</include>
