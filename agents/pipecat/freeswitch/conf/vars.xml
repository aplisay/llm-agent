<?xml version="1.0"?>
<include>
  <X-PRE-PROCESS cmd="set" data="domain=$${domain}"/>
  <X-PRE-PROCESS cmd="set" data="local_ip_v4=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="sip_port=5060"/>
  <X-PRE-PROCESS cmd="set" data="sip_tls_port=5061"/>
  <X-PRE-PROCESS cmd="set" data="rtp_start_port=16384"/>
  <X-PRE-PROCESS cmd="set" data="rtp_end_port=16484"/>

  <X-PRE-PROCESS cmd="env-set" data="esl_secret=$ESL_SECRET"/>
  <X-PRE-PROCESS cmd="env-set" data="ext_ipv4_address=$EXT_IP_ADDRESS"/>

  <!-- The Pipecat worker's mod_audio_stream WebSocket endpoint.
       Container-to-container: ws://pipecat-worker:8082/freeswitch/audio
       The dialplan substitutes this into the audio_stream application. -->
  <X-PRE-PROCESS cmd="env-set" data="pipecat_ws_url=$PIPECAT_WS_URL"/>

  <X-PRE-PROCESS cmd="set" data="global_codec_prefs=PCMU,PCMA,G722"/>
  <X-PRE-PROCESS cmd="set" data="outbound_codec_prefs=PCMU,PCMA,G722"/>
</include>
