# Pipecat agent stack — example environment file.
#
# Copy to .env in the same directory as docker-compose.yml.
# Most values are mandatory in production; defaults exist for local dev only.

# Public IP FreeSWITCH advertises in SDP (and in SIP Via/Contact).
# For local development, your machine's LAN IP. In production, the public IP
# the upstream SBC routes to.
EXT_IP_ADDRESS=127.0.0.1

# Shared secrets — generate with `openssl rand -hex 32`.
ESL_SECRET=change-me-esl
CALL_API_TOKEN=change-me-call-api
WORKER_EVENT_TOKEN=change-me-call-api    # default: same as CALL_API_TOKEN

# Auth shared with lib/handlers/pipecat.js on the llm-agent server side.
PIPECAT_DISPATCH_TOKEN=change-me-dispatch
PIPECAT_JOIN_SECRET=change-me-join

# llm-agent REST server (agent-db callbacks).
SERVICE_BASE_URI=https://api.aplisay.example
SHARED_API_TOKEN=change-me-shared

# Override these if your container layout is different from host networking.
PIPECAT_WS_URL=ws://127.0.0.1:8082/freeswitch/audio
WORKER_EVENT_WEBHOOK=http://127.0.0.1:8082/freeswitch/events

# Provider keys — uncomment for those you actually use.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=

LOGLEVEL=info
