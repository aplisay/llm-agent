# Every `.env*` file holds real secrets and is never committed (the repo-root
# .gitignore excludes `.env*` globally). Committed, secret-free templates use the
# `env-example*` naming instead, so they don't match the pattern — no negation
# "holes" in the exclusion.

# Generated by deploy/gcp/deploy-node.sh — never commit last-run state or the
# materialised compose file.
deploy/gcp/.last-deployment
deploy/gcp/docker-compose.yaml
