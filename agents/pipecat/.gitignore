# Allow committing the .env example templates even though the root .gitignore
# excludes everything matching `.env*`.
!.env.example
!.env.example.k8s
.env*

# Generated by deploy/gcp/deploy-node.sh — never commit secrets, last-run
# state, or the materialised compose file.
deploy/gcp/.env.staging
deploy/gcp/.env.production
deploy/gcp/.last-deployment
deploy/gcp/docker-compose.yaml

# Materialised .env files for the k8s secretenv bundle source (deploy/k8s).
# bundle-secretenv.sh reads these to build the bundle — never commit them.
deploy/k8s/.env
deploy/k8s/.env.staging
deploy/k8s/.env.production
