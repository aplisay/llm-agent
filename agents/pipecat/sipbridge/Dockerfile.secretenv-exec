# secretenv-exec — a tiny static helper that decrypts SECRETENV_BUNDLE into the
# environment and execs the wrapped command. Used by the Kubernetes freeswitch
# and voiceblender overlays (containers that can't decrypt the bundle natively)
# so they can share the single SECRETENV_KEY + SECRETENV_BUNDLE secret.
#
# Built from the sipbridge Go module (reuses internal/secretenv). The runtime
# base is busybox rather than distroless so an initContainer can `cp` the binary
# out into a shared volume for the app containers to exec.
#
# No BuildKit-only features (cache mounts / `# syntax`) — Cloud Build's
# gcr.io/cloud-builders/docker runs the legacy builder, where `--mount` errors.
#
# Build context is the repo root (same as the sipbridge image):
#   docker build -f agents/pipecat/sipbridge/Dockerfile.secretenv-exec -t secretenv-exec .

FROM golang:1.24-bookworm AS builder

WORKDIR /src

COPY agents/pipecat/sipbridge/go.mod agents/pipecat/sipbridge/go.sum* ./
RUN go mod download

COPY agents/pipecat/sipbridge/ .

ARG VERSION=dev
# TARGETARCH is auto-set by BuildKit but unset on the legacy builder, so default
# it to amd64 (Cloud Build's architecture).
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/secretenv-exec \
      ./cmd/secretenv-exec

FROM busybox:stable

COPY --from=builder /out/secretenv-exec /usr/local/bin/secretenv-exec

ENTRYPOINT ["/usr/local/bin/secretenv-exec"]
